    "Strings": {
      "AIRCRAFT.DESCRIPTION": {
        "UUID": "f7f14f45-2391-4a27-84ac-c789501eafd6",
        "LastModifiedBy": "dmedina",
        "LastModifiedDate": "2020-07-01 11:54:59",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "Flight Logic A320neo is a development build of the Airbus A320neo for Microsoft Flight Simulator 2024. This prototype keeps the FlyByWire A32NX avionics foundation while adding Flight Logic experimental flight-management features, including early lateral offset support for route testing.</br></br>This build is intended for development and evaluation. FlyByWire Simulations remains credited for the original A32NX systems foundation; Flight Logic branding marks this customized prototype package.",
            "LocalizationStatus": "TranslationNeeded"
          },
          "fr-FR": {
            "Text": "Flight Logic A320neo is a development build of the Airbus A320neo for Microsoft Flight Simulator 2024. This prototype keeps the FlyByWire A32NX avionics foundation while adding Flight Logic experimental flight-management features, including early lateral offset support for route testing.</br></br>This build is intended for development and evaluation. FlyByWire Simulations remains credited for the original A32NX systems foundation; Flight Logic branding marks this customized prototype package."
          },
          "es-ES": {
            "Text": "Flight Logic A320neo is a development build of the Airbus A320neo for Microsoft Flight Simulator 2024. This prototype keeps the FlyByWire A32NX avionics foundation while adding Flight Logic experimental flight-management features, including early lateral offset support for route testing.</br></br>This build is intended for development and evaluation. FlyByWire Simulations remains credited for the original A32NX systems foundation; Flight Logic branding marks this customized prototype package."
          },
          "de-DE": {
            "Text": "Flight Logic A320neo is a development build of the Airbus A320neo for Microsoft Flight Simulator 2024. This prototype keeps the FlyByWire A32NX avionics foundation while adding Flight Logic experimental flight-management features, including early lateral offset support for route testing.</br></br>This build is intended for development and evaluation. FlyByWire Simulations remains credited for the original A32NX systems foundation; Flight Logic branding marks this customized prototype package."
          },
          "it-IT": {
            "Text": "Flight Logic A320neo is a development build of the Airbus A320neo for Microsoft Flight Simulator 2024. This prototype keeps the FlyByWire A32NX avionics foundation while adding Flight Logic experimental flight-management features, including early lateral offset support for route testing.</br></br>This build is intended for development and evaluation. FlyByWire Simulations remains credited for the original A32NX systems foundation; Flight Logic branding marks this customized prototype package."
          },
          "pl-PL": {
            "Text": "Flight Logic A320neo is a development build of the Airbus A320neo for Microsoft Flight Simulator 2024. This prototype keeps the FlyByWire A32NX avionics foundation while adding Flight Logic experimental flight-management features, including early lateral offset support for route testing.</br></br>This build is intended for development and evaluation. FlyByWire Simulations remains credited for the original A32NX systems foundation; Flight Logic branding marks this customized prototype package."
          },
          "pt-BR": {
            "Text": "Flight Logic A320neo is a development build of the Airbus A320neo for Microsoft Flight Simulator 2024. This prototype keeps the FlyByWire A32NX avionics foundation while adding Flight Logic experimental flight-management features, including early lateral offset support for route testing.</br></br>This build is intended for development and evaluation. FlyByWire Simulations remains credited for the original A32NX systems foundation; Flight Logic branding marks this customized prototype package."
          },
          "ru-RU": {
            "Text": "Flight Logic A320neo is a development build of the Airbus A320neo for Microsoft Flight Simulator 2024. This prototype keeps the FlyByWire A32NX avionics foundation while adding Flight Logic experimental flight-management features, including early lateral offset support for route testing.</br></br>This build is intended for development and evaluation. FlyByWire Simulations remains credited for the original A32NX systems foundation; Flight Logic branding marks this customized prototype package."
